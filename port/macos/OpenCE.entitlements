<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
The app's entitlements under the hardened runtime, which notarization
requires (tools/macos_release.py). The game is compiled ahead of time
(wasm2c) and needs no JIT or unsigned executable memory; the microphone is
for voice chat in network games (Info.plist's NSMicrophoneUsageDescription).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
