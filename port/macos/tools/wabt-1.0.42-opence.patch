diff --git a/src/tools/wasm2c.cc b/src/tools/wasm2c.cc
index b59f2cc..3de758e 100644
--- a/src/tools/wasm2c.cc
+++ b/src/tools/wasm2c.cc
@@ -69,6 +69,11 @@ static bool IsFeatureSupported(const std::string& feature) {
                    feature) != std::end(supported_features);
 };
 
+// (OpenCE) a shared memory compiled as an unshared one: plain loads and
+// stores, as native C makes them; the atomic operations stay atomic
+// (wasm2c_atomicops.declarations.c) and wait/notify are the embedder's
+static bool s_unshared_memory = false;
+
 static void ParseOptions(int argc, char** argv) {
   OptionParser parser("wasm2c", s_description);
 
@@ -92,6 +97,9 @@ static void ParseOptions(int argc, char** argv) {
       "file is used as the default.\n",
       [](const char* argument) { s_write_c_options.module_name = argument; });
   s_write_c_options.features.AddOptions(&parser);
+  parser.AddOption("unshared-memory",
+                   "Compile shared memories as unshared ones (plain accesses)",
+                   []() { s_unshared_memory = true; });
   parser.AddOption("no-debug-names", "Ignore debug names in the binary file",
                    []() { s_read_debug_names = false; });
   parser.AddArgument("filename", OptionParser::ArgumentCount::One,
@@ -136,6 +144,16 @@ Result Wasm2cMain(Errors& errors) {
       ReadBinaryIr(s_infile.c_str(), file_data, options, &errors, &module));
   CHECK_RESULT(ValidateModule(&module, &errors, s_write_c_options.features));
   CHECK_RESULT(GenerateNames(&module));
+  if (s_unshared_memory) {
+    for (Memory* memory : module.memories) {
+      memory->page_limits.is_shared = false;
+    }
+    for (Import* import : module.imports) {
+      if (import->kind() == ExternalKind::Memory) { auto* memory_import = static_cast<MemoryImport*>(import);
+        memory_import->memory.page_limits.is_shared = false;
+      }
+    }
+  }
   /* TODO(binji): This shouldn't fail; if a name can't be applied
    * (because the index is invalid, say) it should just be skipped. */
   (void)ApplyNames(&module);
