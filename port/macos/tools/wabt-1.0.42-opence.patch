         return;
       }
 
-      case ExprType::AtomicWait:
-      case ExprType::AtomicNotify:
+      case ExprType::AtomicWait: {
+        // (OpenCE: memory.atomic.wait32/64 as a call to the embedder's
+        // wasm_rt_atomic_wait32/64(host address, expected, timeout ns))
+        const auto& wait = *cast<AtomicWaitExpr>(&expr);
+        Memory* memory =
+            module_->memories[module_->GetMemoryIndex(wait.memidx)];
+        bool is64 = wait.opcode == Opcode::MemoryAtomicWait64;
+        Write(StackVar(2, Type::I32), " = ",
+              is64 ? "wasm_rt_atomic_wait64" : "wasm_rt_atomic_wait32", "(",
+              "MEM_ADDR(", ExternalInstancePtr(ModuleFieldType::Memory,
+                                                memory->name),
+              ", ");
+        WriteMemoryAddress(2, memory, wait.offset);
+        Write(", ", is64 ? "8" : "4", "), ", StackVar(1), ", (s64)",
+              StackVar(0), ");", Newline());
+        DropTypes(3);
+        PushType(Type::I32);
+      } break;
+
+      case ExprType::AtomicNotify: {
+        const auto& notify = *cast<AtomicNotifyExpr>(&expr);
+        Memory* memory =
+            module_->memories[module_->GetMemoryIndex(notify.memidx)];
+        Write(StackVar(1, Type::I32), " = wasm_rt_atomic_notify(MEM_ADDR(",
+              ExternalInstancePtr(ModuleFieldType::Memory, memory->name),
+              ", ");
+        WriteMemoryAddress(1, memory, notify.offset);
+        Write(", 4), ", StackVar(0), ");", Newline());
+        DropTypes(2);
+        PushType(Type::I32);
+      } break;
+
       case ExprType::CallRef:
       case ExprType::ReturnCallRef:
       case ExprType::Quaternary:
